generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  STORE_MANAGER
  ASSISTANT_STORE_MANAGER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum RequestKind{
  TIME_OFF
  PARTIAL_DAY
}

enum NotificationStatus{
  QUEUED
  SENT
  FAILED
}

enum CoverStatus{
  OPEN
  COVERED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Staff {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  role              Role           @default(STAFF)
  employmentType    EmploymentType @default(PART_TIME)
  targetDaysPerWeek Int?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  auth0Id           String?        @unique
  availability        AvailabilityRule[]
  availabilityChanges AvailabilityChange[] @relation("ChangeStaff")
  decidedChanges      AvailabilityChange[] @relation("ChangeDecider")
  timeOffRequests TimeOffRequest[] @relation("RequestStaff")
  decidedRequests TimeOffRequest[] @relation("RequestDecider")
  shifts Shift[]
  invitedAt     DateTime?
  firstSignInAt DateTime?
  notifications Notification[]
  coverRequests CoverRequest[] @relation("CoverRequester")
  coversTaken   CoverRequest[] @relation("CoverTaker")
  pickupOffers  PickupOffer[]  @relation("PickupStaff")
  auditEntries  AuditLog[]     @relation("AuditActor")
}

enum AvailabilityStatus {
  ALL_DAY
  WINDOW
  UNAVAILABLE
}

enum ChangeStatus {
  PENDING
  APPROVED
  DECLINED
}

// One row per weekday. 0 = Monday … 6 = Sunday. Times are minutes since midnight.
model StoreHours {
  weekday  Int @id
  openMin  Int
  closeMin Int
}

// A staff member's approved, repeating weekly pattern: one row per weekday.
model AvailabilityRule {
  id       String             @id @default(cuid())
  staff    Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId  String
  weekday  Int
  status   AvailabilityStatus
  startMin Int?
  endMin   Int?

  @@unique([staffId, weekday])
}

// A proposed new pattern waiting for (or decided by) a manager.
model AvailabilityChange {
  id          String       @id @default(cuid())
  staff       Staff        @relation("ChangeStaff", fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  days        Json         // 7 entries, Monday first
  note        String?
  status      ChangeStatus @default(PENDING)
  managerNote String?
  decidedBy   Staff?       @relation("ChangeDecider", fields: [decidedById], references: [id])
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([staffId, status])
}

// A single row (id = 1) holding store-wide scheduling settings.
model StoreSettings {
  id            Int    @id @default(1)
  timeZone      String // e.g. "America/Toronto"
  cutoffWeekday Int    // 0 = Monday … 6 = Sunday, in the week before the schedule week
  cutoffMin     Int    // minutes since midnight: 1080 = 6 PM
}

model TimeOffRequest {
  id          String       @id @default(cuid())
  staff       Staff        @relation("RequestStaff", fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  kind        RequestKind
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date // same as startDate for a partial day
  startMin    Int?         // partial day: available from…
  endMin      Int?         // …until
  note        String?
  late        Boolean      @default(false)
  status      ChangeStatus @default(PENDING)
  managerNote String?
  decidedBy   Staff?       @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([staffId, status])
}

// One schedule week, starting on a Monday.
model Week {
  id          String    @id @default(cuid())
  startDate   DateTime  @unique @db.Date
  version     Int       @default(0) // goes up by one on every publish
  publishedAt DateTime?
  published   Json?     // snapshot of the shifts staff can see
  shifts      Shift[]
}

model Shift {
  id        String   @id @default(cuid())
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId    String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  date      DateTime @db.Date
  startMin  Int
  endMin    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coverRequests CoverRequest[]

  @@unique([staffId, date]) // one shift per person per day
  @@index([weekId])
}

// Every email TalkShift sends, rendered when it's queued.
model Notification {
  id          String             @id @default(cuid())
  staff       Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId     String?
  toEmail     String
  template    String             // invite | schedule_published | schedule_updated
  subject     String
  html        String
  text        String
  attachments Json?              // [{ filename, contentType, content (base64) }]
  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  lastError   String?
  sendAfter   DateTime           @default(now())
  sentAt      DateTime?
  createdAt   DateTime           @default(now())

  @@index([status, sendAfter])
}

// "I can't make this shift." The shift stays theirs until someone is confirmed.
model CoverRequest {
  id          String         @id @default(cuid())
  shift       Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId     String
  requester   Staff          @relation("CoverRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  reason      String?
  status      CoverStatus    @default(OPEN)
  coveredBy   Staff?         @relation("CoverTaker", fields: [coveredById], references: [id])
  coveredById String?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  offers      PickupOffer[]

  @@index([status])
}

// "I can take it."
model PickupOffer {
  id             String       @id @default(cuid())
  coverRequest   CoverRequest @relation(fields: [coverRequestId], references: [id], onDelete: Cascade)
  coverRequestId String
  staff          Staff        @relation("PickupStaff", fields: [staffId], references: [id], onDelete: Cascade)
  staffId        String
  status         OfferStatus  @default(PENDING)
  createdAt      DateTime     @default(now())

  @@unique([coverRequestId, staffId])
}

// Who changed what, and when.
model AuditLog {
  id        String   @id @default(cuid())
  actor     Staff?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String   // e.g. cover.requested, cover.assigned
  entity    String   // e.g. CoverRequest
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}